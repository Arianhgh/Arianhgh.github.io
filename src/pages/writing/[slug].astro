---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { allVisiblePosts, dateLabel } from '../../lib/content';
import { sitePath } from '../../lib/paths';

export async function getStaticPaths() {
  const posts = await allVisiblePosts();
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.summary || `A ${post.data.kind} by Arian Haghparast.`}>
  <article>
    <header class="page-intro article-head"><a class="back-link" href={sitePath('/writing/')}>← All writing</a><p class="kicker"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time> <span aria-hidden="true">/</span> {post.data.kind}</p><h1>{post.data.title}</h1>{post.data.summary && <p class="page-lead">{post.data.summary}</p>}{post.data.draft && <p class="draft-notice">Draft preview</p>}</header>
    <div class="prose"><Content /></div>
  </article>
</Base>
