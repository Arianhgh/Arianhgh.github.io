---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { publishedPosts } from '../../../lib/content';
import { sitePath } from '../../../lib/paths';

export async function getStaticPaths() {
  const posts = await publishedPosts();
  const pages = Math.ceil(posts.length / 20);
  return Array.from({ length: Math.max(0, pages - 1) }, (_, index) => ({ params: { page: String(index + 2) }, props: { page: index + 2 } }));
}

const { page } = Astro.props;
const posts = await publishedPosts();
const pagePosts = posts.slice((page - 1) * 20, page * 20);
---
<Base title={`Writing, page ${page}`}>
  <header class="page-intro"><p class="kicker">Notes &amp; essays</p><h1>Writing</h1><p class="page-lead">Page {page}</p></header>
  <nav class="writing-filter" aria-label="Writing filters"><a href={sitePath('/writing/')} aria-current="page">All</a><a href={sitePath('/writing/notes/')}>Notes</a><a href={sitePath('/writing/essays/')}>Essays</a></nav>
  <PostList posts={pagePosts} />
  <nav class="pagination" aria-label="Writing pages"><a href={sitePath(page === 2 ? '/writing/' : `/writing/page/${page - 1}/`)}>← Newer posts</a>{page * 20 < posts.length && <a href={sitePath(`/writing/page/${page + 1}/`)}>Older posts →</a>}</nav>
</Base>
