---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { publishedPosts } from '../../lib/content';
import { sitePath } from '../../lib/paths';
const posts = (await publishedPosts()).filter((post) => post.data.kind === 'note');
---
<Base title="Notes" description="Short notes by Arian Haghparast.">
  <header class="page-intro"><p class="kicker">Writing</p><h1>Notes</h1></header>
  <nav class="writing-filter" aria-label="Writing filters"><a href={sitePath('/writing/')}>All</a><a href={sitePath('/writing/notes/')} aria-current="page">Notes</a><a href={sitePath('/writing/essays/')}>Essays</a></nav>
  {posts.length ? <PostList posts={posts} /> : <p class="empty-state">No notes yet.</p>}
</Base>
