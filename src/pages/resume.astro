---
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
import { sitePath } from '../lib/paths';
---
<Base title="Resume" description="Resume of Arian Haghparast, machine learning and AI engineer in Toronto.">
  <div class="resume-actions"><a href={sitePath('/resume.pdf')} download>Download PDF ↓</a><a href={`mailto:${person.email}`}>Email me ↗</a></div>
  <article class="resume-sheet">
    <header class="resume-head"><h1>Arian Haghparast</h1><p>Machine Learning and AI Engineer</p><div>Toronto, ON <span aria-hidden="true">·</span> <a href={`mailto:${person.email}`}>{person.email}</a></div><div><a href={person.github}>GitHub</a><a href={person.linkedin}>LinkedIn</a><a href={person.scholar}>Google Scholar</a></div></header>
    <p class="resume-summary">Machine learning engineer and researcher focused on retrieval, model evaluation, and ML reliability. Develops and deploys RAG applications and builds Python tools for debugging, data leakage detection, and reproducible experimentation, with experience in deep learning and reinforcement learning.</p>
    <section class="resume-section"><h2>Technical Skills</h2><p><strong>ML:</strong> Python, PyTorch, TensorFlow, scikit-learn, NumPy, pandas; reinforcement learning, Transformers, graph neural networks.</p><p><strong>AI systems:</strong> RAG, hybrid retrieval, MongoDB Atlas, model evaluation, experiment tracking, regression testing, caching.</p><p><strong>Engineering:</strong> SQL, Git, GitHub Actions, JavaScript/TypeScript, Next.js, React, Node.js, Vercel.</p></section>
    <section class="resume-section"><h2>Experience</h2>
      <div class="resume-role"><div class="resume-role-heading"><strong>Research Assistant</strong><time>Jan 2024 – Present</time></div><p>Data Mining Lab · York University</p><ul><li>Built Python pipelines that turn large-scale raw datasets into training-ready inputs and reproducible model evaluations, covering ingestion, cleaning, and feature engineering.</li><li>Developed deep learning and reinforcement learning models for decision-making, data compression, and similarity search using PyTorch and TensorFlow.</li><li>Ran cloud-based GPU training and controlled experiments to compare model performance and isolate the effects of individual design choices.</li><li>Automated experiment reporting to compare model quality, memory use, and failure cases across runs; evaluated robustness to changing data and operating conditions.</li><li>Developed methods that learn continuously from incoming data without retaining past training samples, allowing adaptation while keeping memory use bounded.</li></ul></div>
      <div class="resume-role"><div class="resume-role-heading"><strong>AI Engineer, RAG Systems</strong><time>Sep 2025 – Apr 2026</time></div><p>Research Society at York (RSAY) · York University student organization</p><ul><li>Built and deployed a retrieval-augmented generation assistant to help students find research opportunities, with source citations and unsupported-answer guardrails.</li><li>Reduced cold retrieval latency by 82% using conditional query rewriting and LRU embedding caching; instrumented retrieval stages to identify bottlenecks.</li><li>Combined vector search and BM25 with Reciprocal Rank Fusion in MongoDB Atlas, achieving 55 ms median search latency in retrieval benchmarks.</li><li>Built a labeled evaluation set to measure retrieval quality; benchmarked cross-encoder reranking and kept it optional based on its quality and latency tradeoff.</li></ul></div>
    </section>
    <section class="resume-section"><h2>Education</h2><div class="resume-role-heading"><strong>York University · Lassonde School of Engineering</strong><time>2026</time></div><p>BSc, Computer Science · GPA: 3.96/4.00</p><p>Lassonde Undergraduate Research Award; Annual Continuing Student Scholarship; Dean’s Honour Roll.</p></section>
    <section class="resume-section"><h2>Selected Projects</h2>
      <div class="resume-role"><strong><a href="https://github.com/Arianhgh/MLForensics">MLForensics</a> · ML debugging and regression testing (alpha)</strong><ul><li>Built a Python toolkit to investigate ML regressions by comparing metrics and errors alongside changes in code, data, and resource use.</li><li>Implemented run replay, failure minimization, and tensor tracing to isolate model behavior changes and create smaller reproducible cases.</li><li>Added statistical comparisons and CI checks to flag regressions across repeated runs.</li></ul></div>
      <div class="resume-role"><strong><a href="https://github.com/Arianhgh/Leakproof">Leakproof</a> · ML data leakage detection</strong><ul><li>Built a Python tool that flags data leakage and preprocessing mistakes in scikit-learn and pandas workflows.</li><li>Combined static code analysis, dataset audits, and optional runtime probes for train/test overlap and group, temporal, and target leakage.</li><li>Integrated checks into GitHub Actions and generated terminal, JSON, Markdown, and SARIF reports.</li></ul></div>
      <div class="resume-role"><strong><a href="https://github.com/Arianhgh/Vizir">Vizir</a> · Interactive data exploration</strong><ul><li>Built notebook views and shareable offline HTML reports for data quality and model error analysis.</li><li>Added classification and regression diagnostics with adjustable thresholds and linked selections across data subsets.</li></ul></div>
    </section>
    <section class="resume-section"><h2>Selected Publications</h2><ul class="resume-publications"><li><a href="https://doi.org/10.1145/3801963">PathletRL++: Optimizing Trajectory Pathlet Extraction and Dictionary Formation via Reinforcement Learning</a> · Co-first author, ACM TSAS, 2026.</li><li><a href="https://doi.org/10.1145/3822510">Network-Constrained Policy Optimization for Adaptive Multi-Agent Vehicle Routing</a> · Co-first author, ACM TSAS, 2026.</li><li><a href="https://doi.org/10.1109/SM63044.2024.10733535">Robot Wheelchair Convoys for Assistive Human Transportation</a> · Co-author, IEEE Smart Mobility, 2024.</li></ul></section>
    <section class="resume-section"><h2>Additional Experience</h2><div class="resume-role-heading"><strong>Research Assistant · Elder Laboratory, York University</strong><time>Sep – Dec 2023</time></div><p>Built a Node.js/WebSockets backend for real-time dataset access.</p></section>
  </article>
</Base>
