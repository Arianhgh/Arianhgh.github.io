---
import type { CollectionEntry } from 'astro:content';
import { dateLabel } from '../lib/content';
import { sitePath } from '../lib/paths';

interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="entry-list">
  {posts.map((post) => (
    <article class="entry post-entry">
      <div class="entry-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time> <span aria-hidden="true">·</span> {post.data.kind}{post.data.draft && <span class="draft-label">Draft</span>}</div>
      <h3><a href={sitePath(`/writing/${post.data.slug}/`)}>{post.data.title}</a></h3>
      {post.data.summary && <p>{post.data.summary}</p>}
    </article>
  ))}
</div>
