{
  "name": "arian-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "write": "node scripts/writer-server.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "test:writer": "node --test scripts/writer-store.test.mjs",
    "deploy": "npm run check && npm run build && npm run deploy:pages",
    "deploy:pages": "gh-pages -d dist --nojekyll",
    "new:note": "node scripts/new-post.mjs note",
    "new:essay": "node scripts/new-post.mjs essay"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.5",
    "gray-matter": "^4.0.3",
    "katex": "0.16.22",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "gh-pages": "^6.3.0",
    "typescript": "5.9.3"
  }
}
